generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Menu {
  id          String   @id @default(uuid())
  nama        String
  kategori    String
  harga       Int
  deskripsi   String?  @db.Text
  gambarUrl   String?  @db.Text
  createdAt   DateTime @default(now())
}